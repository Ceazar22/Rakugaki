<style>
  .engraving-preview-section {
    padding: 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .back-button {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    color: #333;
    text-decoration: none;
    margin-bottom: 30px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font-family: 'Poppins Regular';
  }

  .back-button svg {
    width: 24px;
    height: 24px;
    fill: #8b1538;
  }

  .engraving-container {
    display: flex;
    gap: 20px;
    align-items: start;
  }

  .preview-section {
    background: white;
    padding: 0px;
    border-radius: 8px;
    flex: 0 0 35%;
    width: auto;
    min-width: 0;
  }

  .product-info {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
    align-items: center;
    width: 100%;
  }

  .product-image {
    width: 120px;
    height: 120px;
    object-fit: contain;
    padding: 10px;
    border-radius: 8px;
  }

  .product-details h3 {
    font-size: 16px;
    margin-bottom: 10px;
    color: #333;
    font-weight: 400;
    line-height: 1.4;
    font-family: 'Poppins Regular';
  }

  .product-price {
    font-size: 24px;
    font-weight: 600;
    color: #333;
    font-family: 'Poppins Semibold';
  }

  .preview-box {
    border: 2px solid #8b1538;
    border-radius: 8px;
    padding: 80px 40px;
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 356px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .preview-text {
    font-size: 48px;
    color: #000;
    text-align: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
    line-height: 1.1;
    position: relative;
    z-index: 2;
  }

  .preview-label {
    text-align: center;
    margin-top: 20px;
    color: #8b1538;
    font-weight: 700;
    font-size: 18px;
    font-family: 'Poppins Bold';
  }

  .preview-note {
    margin-top: 15px;
    padding: 15px;
    border-radius: 6px;
    font-size: 14px;
    line-height: 1.6;
    color: #000000;
    font-family: 'Poppins Regular';
  }

  .preview-note strong {
    color: #8b1538;
  }

  .customization-section {
    background: white;
    padding: 30px;
    border-radius: 8px;
    border: 2px solid #8b1538;
    flex: 1 1 0;
    min-width: 0;
  }

  .customization-tabs {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 10px;
    margin-bottom: 30px;
    border-bottom: 2px solid #e0e0e0;
  }

  .tab-button {
    font-size: 12px;
    font-weight: 500;
    color: #333;
    background: none;
    border: none;
    padding: 12px 8px;
    text-align: center;
    font-family: 'Poppins Medium';
    pointer-events: none;
    line-height: 1.2;
  }

  .engraving-item {
    border-bottom: 1px solid #e0e0e0;
  }

  .engraving-item:last-of-type {
    border-bottom: none;
  }

  .engraving-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
  }

  .engraving-title {
    font-size: 16px;
    font-weight: 600;
    color: #000;
    font-family: 'Poppins Semibold';
    transition: color 0.3s;
  }

  .engraving-title.active {
    color: #931932;
  }

  .engraving-price-delete {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .engraving-price {
    font-size: 16px;
    font-weight: 600;
    color: #333;
    font-family: 'Poppins Bold';
  }

  .delete-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: #999;
  }

  .delete-button:hover {
    color: #8b1538;
  }

  .delete-button svg {
    width: 20px;
    height: 20px;
  }

  .input-row {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 15px;
  }

  .input-row > * {
    min-width: 0;
  }

  .input-group,
  .select-wrapper {
    min-width: 0;
  }

  .input-group {
    position: relative;
  }

  .custom-input {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 25px;
    font-size: 14px;
    outline: none;
    transition: border-color 0.3s;
    font-family: 'Poppins Regular';
  }

  .custom-input:focus {
    border-color: #8b1538;
  }

  .char-counter {
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    color: #999;
    pointer-events: none;
    font-family: 'Poppins Regular';
  }

  .custom-select {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 12px 32px 12px 12px;
    border: 1px solid #ddd;
    border-radius: 25px;
    font-size: 12px;
    outline: none;
    appearance: none;
    background: white;
    cursor: pointer;
    transition: border-color 0.3s;
    font-family: 'Poppins Regular';
  }

  .custom-select:focus {
    border-color: #8b1538;
  }

  .custom-select:disabled {
    background: #f5f5f5;
    cursor: not-allowed;
    color: #999;
  }

  .select-wrapper {
    position: relative;
  }

  .select-wrapper::after {
    content: '';
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 10px;
    background-image: url("data:image/svg+xml,%3Csvg width='18' height='10' viewBox='0 0 18 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M9 3.88147L1.447 0.105467C1.009 -0.113533 0.475 0.0174677 0.188 0.415468C-0.0979996 0.812468 -0.0529996 1.36147 0.292 1.70747L8.292 9.70747C8.683 10.0985 9.315 10.0985 9.706 9.70747L17.706 1.70747C17.9 1.51347 18 1.25647 18 0.999468C18 0.795468 17.937 0.590468 17.811 0.415468C17.524 0.0174684 16.991 -0.113532 16.552 0.105468L9 3.88147Z' fill='%231A1A1A'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: center;
    pointer-events: none;
  }

  .no-colors-text {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #ddd;
    border-radius: 25px;
    font-size: 14px;
    background: #f5f5f5;
    color: #999;
    text-align: center;
    font-family: 'Poppins Regular';
    height: 43px;
    display: flex;
    align-items: center;
}

  .add-button {
    display: flex;
    align-items: center;
    gap: 10px;
    background: none;
    border: none;
    color: #333;
    font-size: 16px;
    cursor: pointer;
    padding: 10px 0;
    margin-top: 10px;
    font-family: 'Poppins Regular';
  }

  .add-button svg {
    width: 20px;
    height: 20px;
  }

  .notes-textarea {
    width: 100%;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 12px;
    font-size: 14px;
    resize: vertical;
    min-height: 160px;
    outline: none;
    margin-top: 20px;
    font-family: 'Poppins Regular';
  }

  .notes-textarea:focus {
    border-color: #8b1538;
  }

  .add-to-cart-button {
    width: 100%;
    padding: 16px;
    background: #8b1538;
    color: white;
    border: none;
    border-radius: 25px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 20px;
    transition: background 0.3s;
    font-family: 'Poppins Semibold';
  }

  .add-to-cart-button:hover {
    background: #6d1028;
  }

  .add-to-cart-button:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  .error-message {
    background: #ffebee;
    color: #c62828;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-family: 'Poppins Regular';
  }

  .loading-content {
    text-align: center;
    padding: 40px;
    font-family: 'Poppins Regular';
  }
  @media (max-width: 1248px) {
      .preview-box {
    min-height: 356px;
  }
  }
  @media (max-width: 1247px) {
    .preview-box {
    min-height: 371px;
}
  }
  @media (max-width: 1100px) {
    .customization-tabs {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    .input-row {
      grid-template-columns: 1fr 1fr;
    }
    .input-row .input-group {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .engraving-preview-section {
      padding: 15px;
    }

    .engraving-container {
      flex-direction: column;
      gap: 20px;
    }

    .product-info {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .preview-box {
      padding: 60px 20px;
      min-height: 200px;
    }

    .preview-text {
      font-size: 36px;
    }

    .customization-section {
      padding: 20px;
    }

    .customization-tabs {
      gap: 8px;
      overflow-x: auto;
    }

    .tab-button {
      font-size: 11px;
      white-space: nowrap;
      padding: 10px 6px;
    }

    .input-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .engraving-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .preview-section {
      order: 1;
      flex: none;
      width: 100%;
    }

    .customization-section {
      order: 2;
      width: 100%;
    }
  }

  .loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.9);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  .loading-overlay.active {
    display: flex;
  }

  .spinner {
    width: 50px;
    height: 50px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #8b1538;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  {% if section.settings.font_1 != blank %}
  @font-face {
    font-family: 'CustomFont1';
    src: url('{{ section.settings.font_1 }}');
  }
  {% endif %}
  {% if section.settings.font_2 != blank %}
  @font-face {
    font-family: 'CustomFont2';
