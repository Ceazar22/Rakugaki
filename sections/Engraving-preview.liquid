<style>
  .engraving-preview-section {
    padding: 20px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .back-button {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    color: #333;
    text-decoration: none;
    margin-bottom: 30px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font-family: 'Poppins Regular';
  }

  .back-button svg {
    width: 24px;
    height: 24px;
    fill: #8b1538;
  }

  .engraving-container {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .preview-footer {
    width: 35%;
  }

  .preview-footer--mobile {
    display: none;
  }

  .preview-section {
    background: white;
    padding: 0px;
    border-radius: 8px;
    flex: 0 0 35%;
    width: auto;
    min-width: 0;
  }

  .product-info {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
    align-items: center;
    width: 100%;
  }

  .product-image {
    width: 120px;
    height: 120px;
    object-fit: contain;
    padding: 10px;
    border-radius: 8px;
    border: 2px solid #8b1538;
}

  .product-details h3 {
    font-size: 16px;
    margin-bottom: 10px;
    color: #333;
    font-weight: 400;
    line-height: 1.4;
    font-family: 'Poppins Regular';
  }

  .product-price {
    font-size: 24px;
    font-weight: 600;
    color: #333;
    font-family: 'Poppins Semibold';
  }

  .gift-box-summary {
    display: none;
    margin-top: -15px;
  }

  .gift-box-summary.is-visible {
    display: flex;
  }

  .preview-box {
    border: 2px solid #8b1538;
    border-radius: 8px;
    padding: 80px 40px;
    position: relative;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 356px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .preview-text {
    font-size: 48px;
    color: #000;
    text-align: center;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
    line-height: 1.1;
    position: relative;
    z-index: 2;
  }

  .preview-label {
    text-align: center;
    margin-top: 20px;
    color: #8b1538;
    font-weight: 700;
    font-size: 18px;
    font-family: 'Poppins Bold';
  }

  .preview-note {
    margin-top: 15px;
    padding: 15px;
    border-radius: 6px;
    font-size: 14px;
    line-height: 1.6;
    color: #000000;
    font-family: 'Poppins Regular';
  }

  .preview-note strong {
    color: #8b1538;
  }

  .customization-section {
    background: white;
    padding: 30px;
    border-radius: 8px;
    border: 2px solid #8b1538;
    flex: 1 1 0;
    min-width: 0;
  }

  .customization-section.has-gift-box {
    align-self: stretch;
    display: flex;
    flex-direction: column;
  }

  .customization-section.has-gift-box .notes-textarea {
    flex: 1 1 160px;
  }

  .customization-tabs {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 10px;
    margin-bottom: 30px;
    border-bottom: 2px solid #e0e0e0;
  }

  .tab-button {
    font-size: 12px;
    font-weight: 500;
    color: #333;
    background: none;
    border: none;
    padding: 12px 8px;
    text-align: center;
