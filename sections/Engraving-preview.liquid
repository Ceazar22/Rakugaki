</style>

<div class="engraving-preview-section">
  <button class="back-button" onclick="window.history.back()">
<svg width="16" height="29" viewBox="0 0 16 29" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M9.61991 14.1481L15.5559 2.27463C15.9002 1.58608 15.6942 0.74662 15.0685 0.295448C14.4445 -0.154152 13.5814 -0.0834101 13.0375 0.458939L0.46128 13.0352C-0.153382 13.6498 -0.153382 14.6433 0.461281 15.258L13.0375 27.8342C13.3425 28.1392 13.7465 28.2964 14.1505 28.2964C14.4712 28.2964 14.7934 28.2173 15.0686 27.9993C15.6942 27.5481 15.9002 26.7102 15.5559 26.0201L9.61991 14.1481Z" fill="#931932"/>
</svg>
    Back
  </button>

  <div id="mainContent">
    <div class="loading-content">Loading product...</div>
  </div>
</div>

<div class="loading-overlay" id="loadingOverlay">
  <div class="spinner"></div>
</div>

<script>
  (function() {
    const productData = JSON.parse(sessionStorage.getItem('customizeProduct'));

    if (!productData) {
      document.getElementById('mainContent').innerHTML = '<div class="error-message">No product data found. Please select a product first.</div>';
      return;
    }

    const engravingPrice = {{ section.settings.engraving_price | default: 25 }};

    const fonts = [
      {% if section.settings.font_name_1 != blank %}
      { name: {{ section.settings.font_name_1 | json }}, family: 'CustomFont1' },
      {% endif %}
      {% if section.settings.font_name_2 != blank %}
      { name: {{ section.settings.font_name_2 | json }}, family: 'CustomFont2' },
      {% endif %}
      {% if section.settings.font_name_3 != blank %}
      { name: {{ section.settings.font_name_3 | json }}, family: 'CustomFont3' },
      {% endif %}
      {% if section.settings.font_name_4 != blank %}
      { name: {{ section.settings.font_name_4 | json }}, family: 'CustomFont4' },
      {% endif %}
      {% if section.settings.font_name_5 != blank %}
      { name: {{ section.settings.font_name_5 | json }}, family: 'CustomFont5' },
      {% endif %}
      {% if section.settings.font_name_6 != blank %}
      { name: {{ section.settings.font_name_6 | json }}, family: 'CustomFont6' },
      {% endif %}
      {% if section.settings.font_name_7 != blank %}
      { name: {{ section.settings.font_name_7 | json }}, family: 'CustomFont7' },
      {% endif %}
      {% if section.settings.font_name_8 != blank %}
      { name: {{ section.settings.font_name_8 | json }}, family: 'CustomFont8' },
      {% endif %}
      {% if section.settings.font_name_9 != blank %}
      { name: {{ section.settings.font_name_9 | json }}, family: 'CustomFont9' },
      {% endif %}
      {% if section.settings.font_name_10 != blank %}
      { name: {{ section.settings.font_name_10 | json }}, family: 'CustomFont10' }
      {% endif %}
    ].filter(f => f && f.name);

    if (fonts.length === 0) {
      fonts.push({ name: 'Default', family: 'inherit' });
    }

    const placementOptions = ['Right Handed', 'Left Handed'];

    const giftBoxOptions = [
  { name: 'No box', price: 0 },
  { name: 'Black', price: 25 },
  { name: 'Black with ribbon', price: 30 },
  { name: 'Gold', price: 25 },
  { name: 'Gold with ribbon', price: 30 },
  { name: 'Rose Gold', price: 25 },
  { name: 'Rose Gold with Ribbon', price: 30 },
  { name: 'Silver', price: 25 },
  { name: 'Silver with Ribbon', price: 30 },
  { name: 'Red', price: 25 },
  { name: 'Red with Ribbon', price: 30 }
];

    function giftBoxPriceByName(name) {
      const o = giftBoxOptions.find(g => g.name === name);
      return o ? o.price : 0;
    }

    function giftBoxLabelForSelect(opt) {
      if (opt.price === 0) return opt.name;
      return opt.name + ' — ₱' + opt.price;
    }

    function isSetProduct() {
      if (!productData.tags || productData.tags.length === 0) {
        return false;
      }

      const setTags = productData.tags.filter(tag => {
        const lowerTag = tag.toLowerCase();
        return /\d+\s*set/.test(lowerTag) || /set\s*\d+/.test(lowerTag);
      });

      return setTags.length > 0;
    }

    function getSetQuantity() {
      if (!productData.tags || productData.tags.length === 0) {
        return 1;
      }

      for (let tag of productData.tags) {
        const lowerTag = tag.toLowerCase();
        const match = lowerTag.match(/(\d+)\s*set|set\s*(\d+)/);
        if (match) {
          const quantity = parseInt(match[1] || match[2]);
          return quantity;
        }
      }

      return 1;
    }

    function isColorValue(value) {
      if (!value) return false;
      const lowerValue = value.toString().toLowerCase().trim();

      const colorNames = [
        'black', 'white', 'red', 'blue', 'green', 'yellow', 'orange', 'purple',
        'pink', 'brown', 'gray', 'grey', 'silver', 'gold', 'beige', 'cream',
        'navy', 'teal', 'cyan', 'magenta', 'maroon', 'olive', 'lime', 'aqua',
        'fuchsia', 'violet', 'indigo', 'tan', 'khaki', 'coral', 'salmon', 'peach',
        'mint', 'lavender', 'plum', 'burgundy', 'crimson', 'scarlet', 'rose',
        'charcoal', 'slate', 'ivory', 'champagne', 'gunmetal', 'pearl', 'bronze',
        'copper', 'steel', 'graphite', 'obsidian', 'onyx', 'smoke', 'ash', 'coal'
      ];

      for (let colorName of colorNames) {
        if (lowerValue.includes(colorName)) {
          return true;
        }
      }

      return false;
    }

    // Locate the option that actually holds the pen colors by its name
    // (e.g. "Pen Color"). This is more reliable than guessing from the
    // value strings and guarantees the Item Variation list matches the
    // Pen Color swatches shown on the product page.
    function findColorOptionIndex() {
      const sample = productData.allVariants && productData.allVariants[0];
      if (!sample) return -1;

      const names = [sample.option1_name, sample.option2_name, sample.option3_name];

      for (let i = 0; i < names.length; i++) {
        const name = (names[i] || '').toString().toLowerCase();
        if (name.includes('color') || name.includes('colour')) {
          return i;
        }
      }

      return -1;
    }

    function extractColors() {
      if (!productData.allVariants || productData.allVariants.length === 0) {
        return [];
      }

      const colorSet = new Set();

      // Preferred path: pull every distinct value from the option named
      // like "Pen Color" so the count/values match the product page.
      const colorIndex = findColorOptionIndex();
      if (colorIndex !== -1) {
        const key = 'option' + (colorIndex + 1);
        productData.allVariants.forEach(variant => {
          if (variant && variant[key]) {
            colorSet.add(variant[key]);
          }
        });
        return Array.from(colorSet);
      }

      // Fallback: no option is named like a color, so guess from values.
      const isSet = isSetProduct();

      if (isSet && productData.options && productData.options.length > 0) {
        const selectedDesign = productData.options[0];

        productData.allVariants.forEach(variant => {
          if (!variant) return;

          if (variant.option1 === selectedDesign) {
            if (isColorValue(variant.option1)) colorSet.add(variant.option1);
            if (isColorValue(variant.option2)) colorSet.add(variant.option2);
            if (isColorValue(variant.option3)) colorSet.add(variant.option3);
          }
        });
      } else {
        productData.allVariants.forEach(variant => {
          if (!variant) return;

          if (isColorValue(variant.option1)) {
            colorSet.add(variant.option1);
          }
          if (isColorValue(variant.option2)) {
            colorSet.add(variant.option2);
          }
          if (isColorValue(variant.option3)) {
            colorSet.add(variant.option3);
          }
        });
      }

      return Array.from(colorSet);
    }

    function getAvailableColors() {
      const usedColors = engravings.map(e => e.color).filter(Boolean);
      return availableColors.filter(color => !usedColors.includes(color));
    }

    const availableColors = extractColors();
    const maxEngravings = getSetQuantity();

    // Default to the pen color the customer already picked on the product
    // page (carried through in productData.options), falling back to the
    // first available color when nothing was selected.
    function getSelectedColor() {
      // Authoritative value resolved on the product page at Customize time.
      if (productData.selectedColor && availableColors.includes(productData.selectedColor)) {
        return productData.selectedColor;
      }

      const colorIndex = findColorOptionIndex();

      if (colorIndex !== -1) {
        const key = 'option' + (colorIndex + 1);

        // 1) Prefer the pen color the customer selected on the product page.
        if (productData.options) {
          const selected = productData.options[colorIndex];
          if (selected && availableColors.includes(selected)) {
            return selected;
          }
        }

        // 2) Fall back to the color of the resolved variant (always set by
        //    the Customize button, even when no swatch radio was captured).
        if (productData.variantId && productData.allVariants) {
          const chosen = productData.allVariants.find(v => v && v.id === productData.variantId);
          if (chosen && chosen[key] && availableColors.includes(chosen[key])) {
            return chosen[key];
          }
        }
      }

      return availableColors.length > 0 ? availableColors[0] : '';
    }

    let engravings = [
      {
        id: 1,
        text: '',
        color: getSelectedColor(),
        font: fonts[0].name,
        placement: placementOptions[0],
        giftBox: giftBoxOptions[0].name
      }
    ];
    let activeEngravingId = 1;

    function renderPage() {
      const productVariantId = productData.variantId;
      const backgroundImage = {{ section.settings.background_image | img_url: 'master' | json }};
      const productPrice = (productData.price / 100).toFixed(2);

      const html = `
        <div class="engraving-container">
          <div class="preview-section">
            <div class="product-info">
              <img src="${productData.image}" alt="${productData.title}" class="product-image">
              <div class="product-details">
                <h3>${productData.title}</h3>
                <div class="product-price">₱${productPrice}</div>
              </div>
            </div>

            <div class="preview-box" id="previewBox" style="background-image: url('${backgroundImage}')">
              <div class="preview-text" id="previewText">Preview</div>
            </div>

            <div class="preview-label">Product 1</div>

            <div class="preview-note">
              <strong>Note:</strong> The preview reflects font appearance only. Final placement, engraving outcome, and color will vary depending on the specific pen model and material.
            </div>
          </div>

          <div class="customization-section">
            <div class="customization-tabs">
              <div class="tab-button">Personalize</div>
              <div class="tab-button">Item Variation</div>
              <div class="tab-button">Fonts</div>
              <div class="tab-button">Placement</div>
              <div class="tab-button">Gift Box</div>
            </div>

            <div id="engravingList"></div>

            <button class="add-button" id="addEngravingBtn">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
              </svg>
              Add
            </button>

            <textarea class="notes-textarea" placeholder="Add additional notes" id="additionalNotes"></textarea>

            <button class="add-to-cart-button" id="addToCartBtn">Add to Cart</button>
          </div>
        </div>
      `;

      document.getElementById('mainContent').innerHTML = html;

      const addEngravingBtn = document.getElementById('addEngravingBtn');
      if (addEngravingBtn) {
        addEngravingBtn.addEventListener('click', () => addEngraving());
      }

      const addToCartBtn = document.getElementById('addToCartBtn');
      if (addToCartBtn) {
        addToCartBtn.addEventListener('click', () => addToCart(productVariantId));
      }

      renderEngravings();
    }

    function renderEngravings() {
      const container = document.getElementById('engravingList');
      if (!container) return;

      container.innerHTML = '';

      engravings.forEach((engraving, index) => {
        const item = document.createElement('div');
        item.className = 'engraving-item';

        const deleteBtn = engravings.length > 1 ? `
          <button class="delete-button" data-id="${engraving.id}">
            <svg width="16" height="20" viewBox="0 0 16 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M6 0L5 1H0V3H1V18C1 18.5222 1.19133 19.0546 1.56836 19.4316C1.94539 19.8087 2.47778 20 3 20H13C13.5222 20 14.0546 19.8087 14.4316 19.4316C14.8087 19.0546 15 18.5222 15 18V3H16V1H11L10 0H6ZM3 3H13V18H3V3ZM5 5V16H7V5H5ZM9 5V16H11V5H9Z" fill="#1A1A1A"/>
            </svg>
          </button>
        ` : '';

        const isActive = engraving.id === activeEngravingId;

        let colorField = '';
        if (availableColors.length > 0) {
          const availableForSelection = availableColors.filter(color =>
            color === engraving.color || !engravings.some(e => e.color === color && e.id !== engraving.id)
          );

          if (availableForSelection.length > 0) {
            colorField = `
              <div class="select-wrapper">
                <select class="custom-select" data-id="${engraving.id}" data-field="color">
                  ${availableForSelection.map(c => `<option value="${c}" ${engraving.color === c ? 'selected' : ''}>${c}</option>`).join('')}
                </select>
              </div>
            `;
          } else {
            colorField = `<div class="no-colors-text">No Variation available</div>`;
          }
        } else {
          colorField = `<div class="no-colors-text">No Variation</div>`;
        }

        const placementField = `
          <div class="select-wrapper">
            <select class="custom-select" data-id="${engraving.id}" data-field="placement">
              ${placementOptions.map(p => `<option value="${p}" ${engraving.placement === p ? 'selected' : ''}>${p}</option>`).join('')}
            </select>
          </div>
        `;

        const giftBoxField = `
          <div class="select-wrapper">
            <select class="custom-select" data-id="${engraving.id}" data-field="giftBox">
              ${giftBoxOptions.map(g => `<option value="${g.name}" ${engraving.giftBox === g.name ? 'selected' : ''}>${giftBoxLabelForSelect(g)}</option>`).join('')}
            </select>
          </div>
        `;

        item.innerHTML = `
          <div class="engraving-header">
            <div class="engraving-title ${isActive ? 'active' : ''}">Product ${index + 1}</div>
            <div class="engraving-price-delete">
              <div class="engraving-price">₱${engravingPrice.toFixed(2)}</div>
              ${deleteBtn}
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <input
                type="text"
                class="custom-input"
                placeholder="Personalize Here…"
                value="${engraving.text}"
                maxlength="40"
                data-id="${engraving.id}"
                data-field="text"
              >
              <span class="char-counter">${engraving.text.length}/40</span>
            </div>
            ${colorField}
            <div class="select-wrapper">
              <select class="custom-select" data-id="${engraving.id}" data-field="font">
                ${fonts.map(f => `<option value="${f.name}" ${engraving.font === f.name ? 'selected' : ''}>${f.name}</option>`).join('')}
              </select>
            </div>
            ${placementField}
            ${giftBoxField}
          </div>
        `;
        container.appendChild(item);
      });

      container.querySelectorAll('.custom-input').forEach(input => {
        input.addEventListener('input', function(e) {
          const id = parseInt(this.dataset.id);
          const engraving = engravings.find(e => e.id === id);
          if (engraving) {
            engraving.text = this.value;
            const counter = this.parentElement.querySelector('.char-counter');
            if (counter) {
              counter.textContent = `${this.value.length}/40`;
            }
            updatePreview();
          }
        });

        input.addEventListener('focus', function() {
          const id = parseInt(this.dataset.id);
          setActiveEngraving(id);
        });
      });

      container.querySelectorAll('.custom-select').forEach(select => {
        select.addEventListener('change', function() {
          const id = parseInt(this.dataset.id);
          const field = this.dataset.field;
          const engraving = engravings.find(e => e.id === id);
          if (engraving) {
            engraving[field] = this.value;
            if (field === 'color') {
              renderEngravings();
            }
            updatePreview();
          }
        });

        select.addEventListener('focus', function() {
          const id = parseInt(this.dataset.id);
          setActiveEngraving(id);
        });
      });

      container.querySelectorAll('.delete-button').forEach(btn => {
        btn.addEventListener('click', function() {
          const id = parseInt(this.dataset.id);
          deleteEngraving(id);
        });
      });

      const addBtn = document.getElementById('addEngravingBtn');
      if (addBtn) {
        const remainingColors = getAvailableColors();
        if (engravings.length >= maxEngravings || (availableColors.length > 0 && remainingColors.length === 0)) {
          addBtn.style.display = 'none';
        } else {
          addBtn.style.display = 'flex';
        }
      }

      updatePreview();
    }

    function setActiveEngraving(id) {
      activeEngravingId = id;

      document.querySelectorAll('.engraving-title').forEach(title => {
        title.classList.remove('active');
      });

      const engravingIndex = engravings.findIndex(e => e.id === id);
      const titles = document.querySelectorAll('.engraving-title');
      if (titles[engravingIndex]) {
        titles[engravingIndex].classList.add('active');
      }

      updatePreview();
    }

    function deleteEngraving(id) {
      if (engravings.length > 1) {
        engravings = engravings.filter(e => e.id !== id);
        if (activeEngravingId === id) {
          activeEngravingId = engravings[0].id;
        }
        renderEngravings();
      }
    }

    function addEngraving() {
      const remainingColors = getAvailableColors();

      if (engravings.length >= maxEngravings) {
        alert(`Maximum ${maxEngravings} item${maxEngravings > 1 ? 's' : ''} allowed for this product.`);
        return;
      }

      if (availableColors.length > 0 && remainingColors.length === 0) {
        alert('All available colors have been used. Please remove an item to add a new one with a different color.');
        return;
      }

      const newId = Math.max(...engravings.map(e => e.id)) + 1;
      engravings.push({
        id: newId,
        text: '',
        color: remainingColors.length > 0 ? remainingColors[0] : '',
        font: fonts[0].name,
        placement: placementOptions[0],
        giftBox: giftBoxOptions[0].name
      });
      activeEngravingId = newId;
      renderEngravings();
    }

    function updatePreview() {
      const activeEngraving = engravings.find(e => e.id === activeEngravingId);
      if (!activeEngraving) return;

      const previewText = document.getElementById('previewText');
      const previewLabel = document.querySelector('.preview-label');

      if (!previewText) return;

      const font = fonts.find(f => f.name === activeEngraving.font);

      previewText.textContent = activeEngraving.text || 'Preview';
      previewText.style.fontFamily = font ? font.family : 'inherit';

      if (previewLabel) {
        const index = engravings.findIndex(e => e.id === activeEngravingId);
        previewLabel.textContent = `Product ${index + 1}`;
      }
    }

    async function getGiftBoxVariantId(price) {
      const handle = 'gift-box-fee';
      try {
        const res = await fetch(`/products/${handle}.js`);
        const product = await res.json();
        const priceInCents = Math.round(price * 100);
        const variant = product.variants.find(v => {
          return parseInt(v.price) === priceInCents || parseFloat(v.price) === price;
        });
        if (!variant) {
          console.warn('Gift box variant not found for price:', price, 'cents:', priceInCents);
          console.warn('Available variants:', product.variants.map(v => ({ id: v.id, price: v.price, title: v.title })));
        }
        return variant ? variant.id : null;
      } catch (e) {
        console.error('Gift box fetch error:', e);
        return null;
      }
    }

    async function addToCart(productVariantId) {
      if (!productVariantId) {
        alert('Product not found. Please try again.');
        return;
      }

      const loadingOverlay = document.getElementById('loadingOverlay');
      if (loadingOverlay) loadingOverlay.classList.add('active');

      const properties = {};

      engravings.forEach((engraving, index) => {
        const i = index + 1;
        if (engraving.text) properties['Engraving ' + i + ' Text'] = engraving.text;
        if (engraving.color) properties['Engraving ' + i + ' Color'] = engraving.color;
        properties['Engraving ' + i + ' Font'] = engraving.font;
        properties['Engraving ' + i + ' Placement'] = engraving.placement;
        const gbPrice = giftBoxPriceByName(engraving.giftBox);
        properties['Engraving ' + i + ' Gift Box'] = gbPrice > 0
          ? engraving.giftBox + ' — ₱' + gbPrice.toFixed(2)
          : engraving.giftBox;
      });

      const notes = document.getElementById('additionalNotes');
      if (notes && notes.value) properties['Additional Notes'] = notes.value;

      const totalEngravingCount = engravings.length;
      const totalEngravingPrice = totalEngravingCount * engravingPrice;
      const totalGiftBoxPrice = engravings.reduce((sum, e) => sum + giftBoxPriceByName(e.giftBox), 0);
      const combinedCustomization = totalEngravingPrice + totalGiftBoxPrice;

      properties['__Engraving Count'] = String(totalEngravingCount);
      properties['__Engraving Fee Per Item'] = '₱' + engravingPrice.toFixed(2);
      properties['__Total Engraving Fee'] = '₱' + totalEngravingPrice.toFixed(2);
      properties['__Total Gift Box Fee'] = '₱' + totalGiftBoxPrice.toFixed(2);
      properties['__Combined Customization Fee'] = '₱' + combinedCustomization.toFixed(2);

      try {
        const items = [{
          id: productVariantId,
          quantity: 1,
          properties: properties
        }];

        const giftBoxEngravings = engravings.filter(e => giftBoxPriceByName(e.giftBox) > 0);

        if (giftBoxEngravings.length > 0) {
          const pricesNeeded = [...new Set(giftBoxEngravings.map(e => giftBoxPriceByName(e.giftBox)))];
          const variantMap = {};

          await Promise.all(pricesNeeded.map(async (price) => {
            const variantId = await getGiftBoxVariantId(price);
            if (variantId) variantMap[price] = variantId;
          }));

          giftBoxEngravings.forEach((engraving, i) => {
            const gbPrice = giftBoxPriceByName(engraving.giftBox);
            const variantId = variantMap[gbPrice];
            if (variantId) {
              items.push({
                id: variantId,
                quantity: 1,
                properties: {
                  'Box Type': engraving.giftBox,
                  'For': 'Product ' + (engravings.indexOf(engraving) + 1),
                  '_linked_to': productData.title
                }
              });
            }
          });
        }

        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items })
        });

        const result = await response.json();

        if (response.ok) {
          sessionStorage.removeItem('customizeProduct');
          window.location.href = '/cart';
        } else {
          alert('Error adding to cart: ' + (result.description || result.message || 'Please try again.'));
        }
      } catch (error) {
        alert('Error adding to cart. Please try again.');
      } finally {
        if (loadingOverlay) loadingOverlay.classList.remove('active');
      }
    }

    renderPage();
  })();
</script>

