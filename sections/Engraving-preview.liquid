      transform: translateY(-50%);
      background-image: url("data:image/svg+xml,%3Csvg width='18' height='10' viewBox='0 0 18 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M9 3.88147L1.447 0.105467C1.009 -0.113533 0.475 0.0174677 0.188 0.415468C-0.0979996 0.812468 -0.0529996 1.36147 0.292 1.70747L8.292 9.70747C8.683 10.0985 9.315 10.0985 9.706 9.70747L17.706 1.70747C17.9 1.51347 18 1.25647 18 0.999468C18 0.795468 17.937 0.590468 17.811 0.415468C17.524 0.0174684 16.991 -0.113532 16.552 0.105468L9 3.88147Z' fill='%231A1A1A'/%3E%3C/svg%3E");
