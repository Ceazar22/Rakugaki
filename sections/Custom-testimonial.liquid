<style>
.testimonial-section {
  width: 100%;
  padding: 60px 0;
  overflow: hidden;
}

.testimonial-container {
  width: 100%;
  max-width: 100%;
}

.testimonial-header {
  text-align: center;
  padding: 0 20px;
  margin-bottom: 50px;
}

.rating-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 20px;
}

.rating-number {
  font-family: 'Poppins Medium';
  font-size: 24px;
  font-weight: 600;
}

.rating-stars {
  display: flex;
  align-items: center;
  color: #FFD700;
}

.testimonial-heading {
  font-family: 'Korosu';
  font-size: 48px;
  font-weight: 700;
  margin: 0 0 20px 0;
  line-height: 1.2;
  text-transform: uppercase;
}

.testimonial-description {
  font-family: 'Poppins Regular';
  font-size: 16px;
  font-weight: 400;
  margin: 0;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
}

.testimonial-carousel-wrapper {
  width: 100%;
  overflow: hidden;
  margin-bottom: 40px;
}

.testimonial-carousel {
  width: 100%;
  position: relative;
}

.testimonial-track {
  display: flex;
  gap: 24px;
  transition: transform 0.5s ease;
  padding: 0 calc((100% - 1200px) / 2);
}

.testimonial-card {
  flex: 0 0 calc((100% - 1200px) / 2 + 384px);
  border-radius: 16px;
  padding: 40px 30px;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  min-height: 320px;
  text-align: center;
  align-items: center;
}

.card-stars {
  display: flex;
  margin-bottom: 20px;
  color: #FFD700;
}

.card-title {
  font-family: 'Poppins Bold';
  font-size: 20px;
  font-weight: 700;
  margin: 0 0 16px 0;
}

.card-description {
  font-family: 'Poppins Regular';
  font-size: 16px;
  font-weight: 400;
  margin: 0 0 20px 0;
  line-height: 1.6;
  flex-grow: 1;
}

.card-customer-name {
  font-family: 'Poppins Regular';
  font-size: 16px;
  font-weight: 400;
  color: #ffffff;
  margin: 0 0 8px 0;
}

.card-verified-text {
  font-family: 'Poppins Regular';
  font-size: 14px;
  font-weight: 400;
  font-style: italic;
  margin: 0;
}

.carousel-navigation {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
}

.nav-button {
  background: transparent;
  border: none;
  cursor: pointer;
  padding: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.3s ease;
  font-size: 32px;
}

.nav-button:hover {
  opacity: 0.7;
}

@media screen and (max-width: 768px) {
  .testimonial-section {
    padding: 40px 0;
  }

  .testimonial-header {
    margin-bottom: 30px;
  }

  .rating-number {
    font-size: 20px;
  }

  .testimonial-heading {
    font-size: 32px;
    line-height: 1.2;
  }

  .testimonial-description {
    font-size: 14px;
  }

  .testimonial-track {
    gap: 16px;
    padding: 0 calc((100% - 280px) / 2);
  }

  .testimonial-card {
    flex: 0 0 calc((100% - 280px) / 2 + 280px);
    padding: 30px 24px;
    min-height: 280px;
  }

  .card-title {
    font-size: 18px;
  }

  .card-description {
    font-size: 14px;
  }

  .card-customer-name {
    font-size: 14px;
  }

  .card-verified-text {
    font-size: 12px;
  }

  .carousel-navigation {
    gap: 16px;
  }

  .nav-button {
    font-size: 28px;
  }
}

@media screen and (min-width: 769px) and (max-width: 1400px) {
  .testimonial-track {
    padding: 0 40px;
  }

  .testimonial-card {
    flex: 0 0 calc((100% - 128px) / 3);
  }

  .testimonial-heading {
    font-size: 40px;
  }
}
</style>

<div class="testimonial-section" style="background-color: {{ section.settings.background_color }};">
  <div class="testimonial-container">
    <div class="testimonial-header">
      <div class="rating-wrapper">
        <span class="rating-number" style="color: {{ section.settings.rating_text_color }};">{{ section.settings.rating_number }}</span>
        <div class="rating-stars">
          {{ section.settings.star_icon }}
        </div>
      </div>
      
      <h2 class="testimonial-heading" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      <p class="testimonial-description" style="color: {{ section.settings.description_color }};">{{ section.settings.description }}</p>
    </div>

    <div class="testimonial-carousel-wrapper">
      <div class="testimonial-carousel" id="testimonial-carousel-{{ section.id }}">
        <div class="testimonial-track">
          {% for block in section.blocks %}
            <div class="testimonial-card" data-block-id="{{ block.id }}" style="background-color: {{ block.settings.card_background_color }};">
              <div class="card-stars">
                {{ block.settings.card_star_icon }}
              </div>
              <h3 class="card-title" style="color: {{ block.settings.card_title_color }};">{{ block.settings.card_title }}</h3>
              <p class="card-description" style="color: {{ block.settings.card_text_color }};">{{ block.settings.card_description }}</p>
              <p class="card-customer-name">{{ block.settings.customer_name }}</p>
              <p class="card-verified-text" style="color: {{ block.settings.card_text_color }};">{{ block.settings.verified_text }}</p>
            </div>
          {% endfor %}
          {% for block in section.blocks %}
            <div class="testimonial-card" data-block-id="{{ block.id }}-clone" style="background-color: {{ block.settings.card_background_color }};">
              <div class="card-stars">
                {{ block.settings.card_star_icon }}
              </div>
              <h3 class="card-title" style="color: {{ block.settings.card_title_color }};">{{ block.settings.card_title }}</h3>
              <p class="card-description" style="color: {{ block.settings.card_text_color }};">{{ block.settings.card_description }}</p>
              <p class="card-customer-name">{{ block.settings.customer_name }}</p>
              <p class="card-verified-text" style="color: {{ block.settings.card_text_color }};">{{ block.settings.verified_text }}</p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="carousel-navigation">
      <button class="nav-button nav-prev" id="prev-{{ section.id }}" style="color: {{ section.settings.arrow_color }};">
        {{ section.settings.prev_arrow_icon }}
      </button>
      <button class="nav-button nav-next" id="next-{{ section.id }}" style="color: {{ section.settings.arrow_color }};">
        {{ section.settings.next_arrow_icon }}
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const carousel = document.getElementById('testimonial-carousel-{{ section.id }}');
    const track = carousel.querySelector('.testimonial-track');
    const prevBtn = document.getElementById('prev-{{ section.id }}');
    const nextBtn = document.getElementById('next-{{ section.id }}');
    const cards = track.querySelectorAll('.testimonial-card');
    
    let currentIndex = 3;
    let cardsPerSlide = window.innerWidth <= 768 ? 1 : 3;
    const totalCards = cards.length / 2;
    let isTransitioning = false;

    function updateCarousel(instant = false) {
      const cardWidth = cards[0].offsetWidth;
      const gap = window.innerWidth <= 768 ? 16 : 24;
      const offset = currentIndex * (cardWidth + gap);
      
      if (instant) {
        track.style.transition = 'none';
      } else {
        track.style.transition = 'transform 0.5s ease';
      }
      
      track.style.transform = `translateX(-${offset}px)`;
      
      if (instant) {
        setTimeout(() => {
          track.style.transition = 'transform 0.5s ease';
        }, 50);
      }
    }

    function nextSlide() {
      if (isTransitioning) return;
      isTransitioning = true;
      
      currentIndex++;
      updateCarousel();
      
      setTimeout(() => {
        if (currentIndex >= totalCards + 3) {
          currentIndex = 3;
          updateCarousel(true);
        }
        isTransitioning = false;
      }, 500);
    }

    function prevSlide() {
      if (isTransitioning) return;
      isTransitioning = true;
      
      currentIndex--;
      updateCarousel();
      
      setTimeout(() => {
        if (currentIndex < 3) {
          currentIndex = totalCards + 2;
          updateCarousel(true);
        }
        isTransitioning = false;
      }, 500);
    }

    nextBtn.addEventListener('click', nextSlide);
    prevBtn.addEventListener('click', prevSlide);

    window.addEventListener('resize', function() {
      const newCardsPerSlide = window.innerWidth <= 768 ? 1 : 3;
      if (newCardsPerSlide !== cardsPerSlide) {
        cardsPerSlide = newCardsPerSlide;
        currentIndex = 3;
        updateCarousel();
      }
    });

    updateCarousel();
  })();
</script>

