<style>
  .gift-section-{{ section.id }} {
    {{ section.settings.full_width | if: 'width: 100%;', 'max-width: 1400px; margin: 60px auto; padding: 0 20px;' }}
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  {% if section.settings.full_width %}
    {% if section.settings.bg_image_desktop %}
      .gift-section-{{ section.id }} {
        background-image: url('{{ section.settings.bg_image_desktop | img_url: 'master' }}');
      }
    {% endif %}
  {% endif %}

  .gift-inner-{{ section.id }} {
    {% if section.settings.full_width %}
      padding: 80px 70px;
    {% else %}
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      border-radius: 15px;
      overflow: hidden;
      padding: 80px 40px;
      margin: 30px;
    {% endif %}
  }

  {% unless section.settings.full_width %}
    {% if section.settings.bg_image_desktop %}
      .gift-inner-{{ section.id }} {
        background-image: url('{{ section.settings.bg_image_desktop | img_url: 'master' }}');
      }
    {% endif %}
  {% endunless %}

  .gift-grid-{{ section.id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 1400px;
    margin: 0 auto;
    gap: 0px;
  }

  .gift-content-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: 0px;
  }

  .gift-heading-{{ section.id }} {
    color: white;
    font-size: 42px;
    font-weight: bold;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: -10px;
    margin-top: 180px;
  }

  .gift-description-{{ section.id }} {
    color: white;
    font-size: 16px;
    line-height: 1.6;
  }

  .gift-button-{{ section.id }} {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: 15px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 400;
    text-align: center;
    transition: opacity 0.3s ease;
    width: fit-content;
    font-family: 'Poppins Regular';
  }

  .gift-button-{{ section.id }}:hover {
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    {% if section.settings.full_width %}
      {% if section.settings.bg_image_mobile %}
        .gift-section-{{ section.id }} {
          background-image: url('{{ section.settings.bg_image_mobile | img_url: 'master' }}');
        }
      {% endif %}
    {% else %}
      .gift-section-{{ section.id }} {
        margin: 30px auto;
      }
    {% endif %}

    .gift-inner-{{ section.id }} {
      {% if section.settings.full_width %}
        padding: 60px 20px;
      {% else %}
        padding: 60px 30px;
      {% endif %}
    }

    {% unless section.settings.full_width %}
      {% if section.settings.bg_image_mobile %}
        .gift-inner-{{ section.id }} {
          background-image: url('{{ section.settings.bg_image_mobile | img_url: 'master' }}');
        }
      {% endif %}
    {% endunless %}

    .gift-grid-{{ section.id }} {
      grid-template-columns: 1fr;
    }

    .gift-heading-{{ section.id }} {
      font-size: 28px;
    }

    .gift-description-{{ section.id }} {
      font-size: 14px;
    }

    .gift-button-{{ section.id }} {
      width: 100%;
    }

    .gift-empty-column-{{ section.id }} {
      display: none;
    }
  }
</style>

<div class="gift-section-{{ section.id }}">
  <div class="gift-inner-{{ section.id }}">
    <div class="gift-grid-{{ section.id }}">
      <div class="gift-content-{{ section.id }}">
        {% if section.settings.heading != blank %}
          <h2 class="gift-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="gift-description-{{ section.id }}">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_url }}" class="gift-button-{{ section.id }}">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>

      <div class="gift-empty-column-{{ section.id }}">
        &nbsp;
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "bg_image_desktop",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GIVE A GIFT THAT FEELS PERSONAL AND THOUGHTFUL"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Finding a meaningful gift shouldn't be complicated. Our premium pens, notebooks, and writing tools are crafted for people who appreciate quality, intention, and the joy of writing—making them the ideal present for graduations, promotions, birthdays, and special moments.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Customize Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#8B1538"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Gift Section"
    }
  ]
}
{% endschema %}