{% schema %}
{
  "name": "Testimonial with Image",
  "class": "testimonial-with-image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Customer Testimonials"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "star_icon",
          "label": "Star Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Precision Fit & Rugged Comfort"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Tailored comfort meets rugged durability—our pants deliver both. The engineered taper fit hugs thighs without restricting movement, while the anti-wrinkle finish and breathable materials keep you looking sharp all day.</p>"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer Name",
          "default": "Martin G."
        },
        {
          "type": "image_picker",
          "id": "check_icon",
          "label": "Check Icon"
        },
        {
          "type": "image_picker",
          "id": "testimonial_image",
          "label": "Testimonial Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial with Image",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .testimonial-with-image {
    padding: 40px 0;
    position: relative;
    overflow: hidden;
  }
  
  .testimonial-slider {
    position: relative;
  }
  
  .testimonial-slides {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
  }
  
  .testimonial-slide {
    flex: 0 0 100%;
    min-width: 100%;
  }
  
  .testimonial-container {
    display: flex;
    flex-direction: row;
    max-width: 1200px;
    margin: 0 auto;
    height: 550px;
  }
  
  .testimonial-content {
    background-color: #F5F5F5;
    border: 1px solid #DDDDDD;
    padding: 40px;
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-right: 0;
  }
  
  .testimonial-image-container {
    width: 50%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    min-height: 400px;
  }
  
  .star-icon {
    margin-bottom: 0px;
    margin-top: 90px;
  }
  
  .testimonial-title {
    font-size: 24px;
    font-family: 'Grotesk Medium';
    margin-bottom: 15px;
    color: #212121;
  }
  
  .testimonial-description {
    margin-bottom: 20px;
    font-size: 16px;
    line-height: 1.5;
  }
  
  .customer-info {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  
  .customer-name {
    margin-right: 10px;
    font-weight: bold;
  }
  
  .testimonial-check-icon {
    width: 25px;
    height: 25px;
  }
  
  .testimonial-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    overflow: hidden;
    max-width: 200px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .dots-container {
    display: flex;
    gap: 10px;
    transition: transform 0.3s ease;
    transform: translateX(250px);
  }
  
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: #D9D9D9;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }
  
  .dot.active {
    background-color: #8E191B;
    border: 1px solid #8E191B;
  }
  
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 35px;
    height: 35px;
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
    z-index: 10;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .slider-arrow svg {
    width: 35px;
    height: 35px;
    transition: all 0.3s ease;
  }
  
  .slider-arrow.prev svg circle {
    fill: rgba(69, 69, 69, 0.25);
    transition: fill 0.3s ease;
  }
  
  .slider-arrow.next svg circle {
    fill: #454545;
  }
  
  .slider-arrow.prev:hover svg circle,
  .slider-arrow.prev.sliding svg circle {
    fill: #454545;
  }
  
  .slider-arrow.prev {
    left: 20px;
  }
  
  .slider-arrow.next {
    right: 20px;
  }
  
  @media (max-width: 768px) {
    .testimonial-with-image {
      padding: 20px 0;
    }
    
    .testimonial-slider {
      position: relative;
      padding-bottom: 50px;
    }
    
    .testimonial-container {
      flex-direction: column;
      height: auto;
      padding-left: 20px;
      padding-right: 20px;
    }
    
    .testimonial-content,
    .testimonial-image-container {
      width: 100%;
    }
    
    .testimonial-image-container {
      margin-bottom: 20px;
      order: 1;
      min-height: 300px;
    }
    
    .testimonial-content {
      order: 2;
      margin-right: 0;
      padding: 20px;
      justify-content: flex-start;
      min-height: auto;
      height: auto;
    }
    
    .testimonial-title {
      font-size: 19px;
    }
    
    .customer-name {
      font-size: 18px;
    }
    
    .testimonial-description {
      line-height: 1.4;
    }
    
    .star-icon {
      margin-top: 0px;
      margin-bottom: 20px;
    }
    
    .customer-info {
      margin-bottom: 0;
    }
    
    .testimonial-dots {
      display: ruby !important;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 0;
      margin-left: -130px;
      padding: 20px;
      position: absolute;
      bottom: 0;
      left: 10px;
      right: 0;
      width: 100%;
      box-sizing: border-box;
      max-width: none;
    }
    
    .dots-container {
      justify-content: center;
      transform: translateX(310px) !important;
    }
    
    .dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background-color: #D9D9D9;
      cursor: pointer;
      transition: all 0.3s ease;
      flex-shrink: 0;
    }
    
    .dot.active {
      background-color: #8E191B;
      border: 1px solid #8E191B;
    }
    
    .slider-arrow {
      display: none;
    }
  }
</style>

<div class="testimonial-with-image">
  {% if section.settings.heading != blank %}
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
  {% endif %}
  
  <div class="testimonial-slider">
    <div class="testimonial-slides" id="testimonial-slides-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="testimonial-slide" data-index="{{ forloop.index0 }}">
          <div class="testimonial-container" {{ block.shopify_attributes }}>
            <div class="testimonial-content">
