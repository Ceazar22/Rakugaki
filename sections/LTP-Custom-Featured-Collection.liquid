{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-custom-featured-collection.css' | asset_url | stylesheet_tag }}

{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}

{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'custom-product-form.js' | asset_url }}" defer="defer"></script>

{% style %}
  .custom-featured-collection--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .custom-featured-collection--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="collection custom-featured-collection custom-featured-collection--{{ section.id }} {% if section.settings.page_width %} page-width{% endif %}">
  <h2 class="featured-collection-heading">{{ section.settings.section_heading }}</h2>
  <div
    class="featured-collection__wrapper"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    {% render 'component-desktop-swiper', section: section %}
    {% render 'component-mobile-swiper', section: section %}
  </div>
</div>

{% schema %}
{
  "name": "Tuned Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Featured Collection"
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "checkbox",
      "id": "page_width",
      "label": "Enable page width",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "loop_mode",
      "label": "Enable loop mode in desktop",
      "default": true
    },
    {
      "type": "range",
      "id": "space_between",
      "min": 0,
      "max": 100,
      "unit": "px",
      "step": 1,
      "label": "Space between",
      "info": "Distance between slides in px.",
      "default": 10
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "min": 1,
      "max": 7,
      "unit": "No.",
      "step": 0.1,
      "label": "Slides per view (desktop)",
      "info": "Number of slides per view (slides visible at the same time on slider's container).",
      "default": 4.1
    },
    {
      "type": "range",
      "id": "slides_per_view_tablet",
      "min": 1,
      "max": 7,
      "unit": "No.",
      "step": 0.1,
      "label": "Slides per view (tablet)",
      "info": "Number of slides per view (slides visible at the same time on slider's container).",
      "default": 3.2
    },
    {
      "type": "range",
      "id": "slides_per_view_mobile",
      "min": 1,
      "max": 7,
      "unit": "No.",
      "step": 1,
      "label": "Slides per view (mobile)",
      "info": "Number of slides per view (slides visible at the same time on slider's container).",
      "default": 2
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Tuned Featured Collection"
    }
  ]
}
{% endschema %}
