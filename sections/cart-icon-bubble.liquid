{% if cart == empty %}
  <span class="svg-wrapper">{{ 'Cart.svg' | inline_asset_content }}</span>
{% else %}
  <span class="svg-wrapper">{{ 'Cart.svg' | inline_asset_content }}</span>
{% endif %}

<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
{%- liquid
  assign cart_display_count = cart.item_count
  for item in cart.items
    if item.properties['_Logo_Fee_Component'] == 'true' or item.properties['_Engraving_Fee_Component'] == 'true'
      assign cart_display_count = cart_display_count | minus: item.quantity
    endif
  endfor
-%}
{%- if cart != empty and cart_display_count > 0 -%}
  <div class="cart-count-bubble">
    {%- if cart_display_count < 100 -%}
      <span aria-hidden="true">{{ cart_display_count }}</span>
    {%- endif -%}
    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart_display_count }}</span>
  </div>
{%- endif -%}
