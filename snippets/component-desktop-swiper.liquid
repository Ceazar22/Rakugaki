      </svg>
      </span>
    </div>
    <div class="tuned-featured-button-next">
      <span class="svg-wrapper">
        
      <svg width="52" height="52" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="0.501642" y="0.501642" width="50.9967" height="50.9967" fill="white"/>
      <rect x="0.501642" y="0.501642" width="50.9967" height="50.9967" stroke="#CECECE" stroke-width="0.996717"/>
      <path d="M19.7717 15.6433C19.7781 15.9168 19.8924 16.1767 20.0896 16.3663L29.7257 26.0024L20.0896 35.6384C19.9903 35.7351 19.9113 35.8506 19.8574 35.9783C19.8035 36.106 19.7757 36.2431 19.7757 36.3817C19.7758 36.588 19.8373 36.7896 19.9525 36.9607C20.0678 37.1318 20.2314 37.2646 20.4225 37.3422C20.6136 37.4199 20.8235 37.4387 21.0254 37.3964C21.2273 37.3541 21.412 37.2525 21.5559 37.1047L31.9251 26.7355C32.1195 26.5411 32.2287 26.2774 32.2287 26.0024C32.2287 25.7274 32.1195 25.4637 31.9251 25.2693L21.5559 14.9001C21.4111 14.7495 21.2242 14.6461 21.0196 14.6036C20.8151 14.561 20.6025 14.5812 20.4096 14.6616C20.2168 14.7419 20.0527 14.8786 19.9388 15.0538C19.825 15.229 19.7667 15.4345 19.7717 15.6433Z" fill="#454545"/>
      </svg>
      </span>
    </div>
  </div>
</div>

<script>
  const customTunedCollectionDesktop{{ section.index }} = new Swiper('.custom-featured-collection--{{ section.id }} .swiper.desktop', {
    direction: 'horizontal',
    loop: {{ section.settings.loop_mode }},
    spaceBetween: {{ section.settings.space_between }},
    slidesPerView: {{ section.settings.slides_per_view_mobile }},
    breakpoints: {
      720: {
        slidesPerView: {{ section.settings.slides_per_view_tablet }},
      },
      1080: {
        slidesPerView: {{ section.settings.slides_per_view_desktop }},
      }
    },
    navigation: {
      nextEl: '.custom-featured-collection--{{ section.id }} .swiper.desktop .tuned-featured-button-next',
      prevEl: '.custom-featured-collection--{{ section.id }} .swiper.desktop .tuned-featured-button-prev',
    }
  });
</script>