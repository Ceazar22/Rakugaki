          </g>
          <path d="M77.6856 1.25082L79.163 5.62478L83.7789 5.67822C84.1762 5.68285 84.3406 6.189 84.022 6.42589L80.3186 9.18222L81.6942 13.5891C81.8124 13.9683 81.3823 14.2807 81.0581 14.051L77.2925 11.3805L73.5264 14.0505C73.2027 14.2802 72.7721 13.9673 72.8903 13.5886L74.2659 9.18171L70.5625 6.42537C70.2439 6.18848 70.4083 5.68233 70.8056 5.67771L75.4216 5.62427L76.8989 1.25031C77.0263 0.874161 77.5587 0.874161 77.6856 1.25082Z" fill="#FF8D3A"/>
